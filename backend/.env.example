DATABASE_URL="postgresql://gacha:gacha@localhost:5432/gacha?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=dev-secret-change-me
# Short-lived access token; clients refresh it via POST /auth/refresh.
JWT_ACCESS_EXPIRES_IN_SECONDS=900
# Rotating refresh token lifetime (7 days).
REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800
PORT=3001
FRONTEND_USER_ORIGIN=http://localhost:3000
FRONTEND_ADMIN_ORIGIN=http://localhost:3002
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=item-images
MINIO_USE_SSL=false

# System config overrides (optional — DB values are used when these are unset).
# See prisma/seed.js for the full list of keys and their defaults.
# PULL_COST=10
# MAX_BULK_PULL=10
# GACHA_PULL_THROTTLE_LIMIT=120
# GACHA_PULL_THROTTLE_TTL_MS=60000
# ADMIN_FEED_RATE_LIMIT_MAX=10
# ADMIN_FEED_RATE_LIMIT_DURATION_MS=1000
# GLOBAL_THROTTLE_LIMIT=40
# GLOBAL_THROTTLE_TTL_MS=60000
# BCRYPT_ROUNDS=10
# REFRESH_TOKEN_BYTES=32
# DEFAULT_REFRESH_EXPIRES_SECONDS=604800
# RECENT_HISTORY_LIMIT=10
# BACKSTOP_TTL_SECONDS=86400
