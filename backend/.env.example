# --- Required ---
DATABASE_URL="postgresql://gacha:gacha@localhost:5432/gacha?schema=public"
JWT_SECRET=dev-secret-change-me

# --- Redis (cache + BullMQ job queue) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth token lifetimes ---
# Short-lived access token; clients refresh it via POST /auth/refresh.
JWT_ACCESS_EXPIRES_IN_SECONDS=900
# Rotating refresh token lifetime (7 days).
REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800

# --- Server ---
PORT=3001
FRONTEND_USER_ORIGIN=http://localhost:3000
FRONTEND_ADMIN_ORIGIN=http://localhost:3002

# --- MinIO (object storage for event/item images) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=item-images
MINIO_USE_SSL=false

# --- Rate limiting (optional — read directly from env at module init;
# changing these requires an application restart) ---
# GLOBAL_THROTTLE_LIMIT=40
# GLOBAL_THROTTLE_TTL_MS=60000
# GACHA_PULL_THROTTLE_LIMIT=120
# GACHA_PULL_THROTTLE_TTL_MS=60000
# ADMIN_FEED_RATE_LIMIT_MAX=10
# ADMIN_FEED_RATE_LIMIT_DURATION_MS=1000

# --- System config (gacha rules, security) ---
# These keys live in the `system_config` DB table and are tuned there, not via
# env vars — see prisma/seed.js for the full list and defaults. The two auth
# lifetimes above are the ONLY system-config keys wired as env overrides
# (see ENV_OVERRIDES in src/system-config/system-config.service.ts); setting
# PULL_COST, MAX_BULK_PULL, BCRYPT_ROUNDS, REFRESH_TOKEN_BYTES,
# RECENT_HISTORY_LIMIT, or BACKSTOP_TTL_SECONDS here has NO effect — edit the
# seed defaults or the DB row directly instead.
